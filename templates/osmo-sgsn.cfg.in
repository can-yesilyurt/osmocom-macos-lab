log stderr
 logging color 0
 logging timestamp 1
 logging level set-all info
line vty
 bind 127.0.0.1 @SGSN_VTY@
ctrl
 bind 127.0.0.1 @SGSN_CTRL@
sgsn
 gtp state-dir @SGSN_DATA_DIR@
 gtp local-ip 127.0.0.2
 ggsn 0 remote-ip 127.0.0.1
 ggsn 0 gtp-version 1
 ggsn 0 echo-interval 30
 auth-policy remote
 authentication optional
 encryption gea 0
 gsup ipa-name SGSN-@MCC@-@MNC@-101
 gsup remote-ip 127.0.0.1
 gsup remote-port 4222
 apn @APN@ ggsn 0
@APN_FALLBACK@
ns
 timer tns-block 3
 timer tns-block-retries 3
 timer tns-reset 3
 timer tns-reset-retries 3
 timer tns-test 30
 timer tns-alive 3
 timer tns-alive-retries 10
 bind udp local
  listen 127.0.0.2 @SGSN_NS@
  accept-ipaccess
bssgp
