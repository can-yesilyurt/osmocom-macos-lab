log stderr
 logging color 0
 logging timestamp 1
 logging level set-all info
line vty
 bind 127.0.0.1 @BSC_VTY@
ctrl
 bind 127.0.0.1 @BSC_CTRL@
e1_input
 e1_line 0 driver ipa
 ipa bind 127.0.0.1
cs7 instance 0
 point-code 0.23.3
 asp asp-clnt-bsc-0 @M3UA@ 0 m3ua
  remote-ip 127.0.0.1
  local-ip 127.0.0.1
  role asp
  sctp-role client
network
 network country code @MCC@
 mobile network code @MNC@
 encryption a5 0
 neci 1
 mgw 0
  remote-ip 127.0.0.1
  remote-port @MGW_BSC_MGCP@
  local-port @BSC_MGCP_CLIENT@
 bts 0
  description Native macOS GSM test BTS
  type osmo-bts
  band GSM900
  cell_identity @CELL_ID@
  location_area_code @LAC@
  base_station_id_code @BSIC@
  ipa unit-id 9000 0
  oml ipa stream-id 255 line 0
  codec-support fr
@GPRS_CONFIG@
  trx 0
   rf_locked 1
   arfcn @ARFCN@
   nominal power 23
   max_power_red @MAX_POWER_REDUCTION_DB@
   rsl e1 tei 0
   timeslot 0
    phys_chan_config CCCH+SDCCH4
   timeslot 1
    phys_chan_config SDCCH8
   timeslot 2
    phys_chan_config TCH/F
   timeslot 3
    phys_chan_config TCH/F
   timeslot 4
    phys_chan_config TCH/F
   timeslot 5
    phys_chan_config TCH/F
   timeslot 6
    phys_chan_config @PDCH_6@
   timeslot 7
    phys_chan_config @PDCH_7@
msc 0
 allow-emergency deny
