log stderr
 logging color 0
 logging timestamp 1
 logging level set-all notice
line vty
 bind 127.0.0.1 @MGW_VTY@
ctrl
 bind 127.0.0.1 @MGW_CTRL@
mgcp
 bind ip 127.0.0.1
 bind port @MGW_MGCP@
 rtp port-range @RTP_FIRST@ @RTP_LAST@
 rtp bind-ip 127.0.0.1
 number endpoints 64
 force-realloc 1
 rtcp-omit
 rtp-patch ssrc
 rtp-patch timestamp
